VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Free VTON development/testing route (official FASHN ZeroGPU Space)
VITE_HF_VTON_SPACE_URL=https://fashn-ai-fashn-vton-1-5.hf.space
VITE_HF_VTON_MODE=direct
VITE_HF_VTON_API_NAME=/try_on
VITE_HF_VTON_PARAM_MAP={"person":"person_image","garment":"garment_image","category":"category"}
VITE_HF_VTON_EXTRA_PARAMS={"garment_photo_type":"flat-lay","num_timesteps":50,"guidance_scale":1.5,"seed":42,"segmentation_free":true}
VITE_HF_VTON_TIMEOUT_SECONDS=600
VITE_HF_VTON_PROVIDER_LABEL=FASHN VTON 1.5 — Free Hugging Face ZeroGPU

# Paid provider intentionally disabled
VITE_PIXELCUT_VTON_ENABLED=false

# WhatsApp chat button (country code + number, digits only)
VITE_WHATSAPP_NUMBER=919876543210

# Share links (optional). The public address of the store, e.g. https://lagamless.com — set it on your host
# (Vercel/Netlify env vars) if shared links ever show the wrong domain. See docs/SHARE_LINKS.md
SITE_URL=

# Public address of the live store. Share links use this instead of localhost, so a link shared while you test
# locally is still a real, tappable https:// address (WhatsApp does not link or preview "localhost").
VITE_SITE_URL=https://lagamless.com
