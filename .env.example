# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase PUBLIC/ANON key (Project Settings → API → Project API keys → anon public)
# NEVER put the service-role key here or anywhere in frontend code.
VITE_SUPABASE_ANON_KEY=

# Razorpay's Key ID/Key Secret/Webhook Secret are NOT set here — checkout
# talks to Razorpay only through Supabase Edge Functions, which read those
# from `supabase secrets`, never from a frontend env var. See
# supabase/functions/README.md.
